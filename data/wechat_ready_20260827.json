    "wechat_html": "<section style='margin:0;padding:0;background-color:#fff;'><img src='https://mmbiz.qpic.cn/mmbiz_gif/3hAJnwuyZuicicZkgJBUCCaricdibomDBrTzXgUR7FJnf11qGIo8nmKt6RxibXrb5s4RFb9UZ9UOHQy7fqQyI377Licw/0?wx_fmt=gif' style='width:100%;display:block;'><section style='padding:0;'><img peitu='true' src='https://raw.githubusercontent.com/duguBoss/daily-renzhi-hub/main/assets/rss_covers/80d8ae526571e4d0.png' style='width:100%;display:block;margin:30px 0;'><p style=\"margin:0 0 24px 0; line-height:2; color:#2c3e50; font-size:16px; letter-spacing:0.8px; text-align:justify;\">你只知道乔布斯曾被苹果赶走，后来又凯旋回归。但你可能不知道，中间那十年，他经历了什么。不是蛰伏，而是地狱。</p><p style=\"margin:0 0 24px 0; line-height:2; color:#2c3e50; font-size:16px; letter-spacing:0.8px; text-align:justify;\">美国知名传记作家杰弗里·凯恩，花了数年时间。他重构了乔布斯离开苹果后的十年轨迹。这段时间里，乔布斯创立了NeXT公司。但它连年亏损，钱像流水一样烧掉。你身边的合伙人也一个接一个地离开。投资人对你彻底失去信心。你个人的财富，几乎消失殆尽。</p><p style=\"margin:0 0 24px 0; line-height:2; color:#2c3e50; font-size:16px; letter-spacing:0.8px; text-align:justify;\">你曾离彻底破产只有一步之遥。只差一个周末，这家公司就要关门。但在那些刻骨铭心的失败中，乔布斯才真正学会了如何成为一名领导者。不是他天生就是传奇，而是被现实打磨成了传奇。这就是那个还不是“乔布斯”的乔布斯。</p><p style=\"margin:0 0 24px 0; line-height:2; color:#2c3e50; font-size:16px; letter-spacing:0.8px; text-align:justify;\">领导力淬炼，从绝境中来。</p><p style=\"margin:0 0 24px 0; line-height:2; color:#2c3e50; font-size:16px; letter-spacing:0.8px; text-align:justify;\">去直面你的至暗时刻。</p><section style='margin:45px 0 20px 0;padding-top:20px;border-top:1px solid #E5E5E5;'><section style='font-size:13px;color:#999;margin-bottom:12px;text-transform:uppercase;'>TAGS</section><section><span style='display:inline-block;margin:0 10px 10px 0;padding:4px 12px;border:1px solid #DCDFE6;color:#606266;font-size:12px;'>乔布斯</span><span style='display:inline-block;margin:0 10px 10px 0;padding:4px 12px;border:1px solid #DCDFE6;color:#606266;font-size:12px;'>苹果</span><span style='display:inline-block;margin:0 10px 10px 0;padding:4px 12px;border:1px solid #DCDFE6;color:#606266;font-size:12px;'>失败</span><span style='display:inline-block;margin:0 10px 10px 0;padding:4px 12px;border:1px solid #DCDFE6;color:#606266;font-size:12px;'>领导力</span><span style='display:inline-block;margin:0 10px 10px 0;padding:4px 12px;border:1px solid #DCDFE6;color:#606266;font-size:12px;'>创业</span></section></section></section><img src='https://mmbiz.qpic.cn/mmbiz_gif/3hAJnwuyZuicicZkgJBUCCaricdibomDBrTzk57DCmhVC16o9ILH0Tn1YPEiarfLRRQSVFN2mJdeYibGnBPialPIzvojw/0?wx_fmt=gif' style='width:100%;display:block;'></section>",
